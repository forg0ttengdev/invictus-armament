	Resources
	[
		[vesper, 15]
		[tristeel, 5]
	]
	AIValueFactor = 0
	Size = [1, 1]
	IsRotateable = false
	SelectionTypeID = "armor"
	MaxHealth = 210000//210000
	ExplosiveDamageAbsorption = 100%
	ExplosiveDamageResistance = 80%
	TypeCategories = [armor, non_flammable]
	Flammable = false
	InitialPenetrationResistance = 7
	ContinuingPenetrationResistance = &InitialPenetrationResistance
	CreatePartPerTileWhenGrabbed = ""
	CrewSpeedFactor = 0
	Density = 9
